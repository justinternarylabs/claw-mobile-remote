+/* A true phone game mode: portal above the shell, below existing dialog layers. */
+.grid-mobile-game {
+  position: fixed;
+  inset: 0;
+  z-index: 40;
+  width: 100%;
+  height: 100dvh;
+  overflow: hidden;
+  isolation: isolate;
+  background: var(--th-bg-primary, #050d15);
+  color: var(--th-text-primary, #d8f5ff);
+  outline: none;
+  user-select: none;
+  -webkit-user-select: none;
+  -webkit-touch-callout: none;
+  overscroll-behavior: none;
+  touch-action: pan-x pan-y;
+}
+.grid-mobile-game-hud {
+  position: absolute;
+  inset: 0 0 auto;
+  z-index: 2;
+  pointer-events: none;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 12px;
+  padding: calc(env(safe-area-inset-top, 0px) + 10px) max(14px, env(safe-area-inset-right, 0px)) 20px
+    max(14px, env(safe-area-inset-left, 0px));
+  background: linear-gradient(#050d15f5, #050d1580 75%, transparent);
+}
+.grid-mobile-game-hud button {
+  pointer-events: auto;
+  min-height: 44px;
+  display: flex;
+  gap: 9px;
+  align-items: center;
+  padding: 9px 14px;
+  border: 1px solid #75dcf065;
+  background: #0a1c29ed;
+  border-radius: 4px;
+  color: #b8f5ff;
+  font-size: 13px;
+  touch-action: manipulation;
+  -webkit-tap-highlight-color: transparent;
+}
+.grid-mobile-game-hud button:focus-visible {
+  outline: 2px solid #b8f5ff;
+  outline-offset: 3px;
+}
+.grid-mobile-game-hud > span {
+  display: flex;
+  gap: 7px;
+  align-items: center;
+  font: 10px var(--th-font-mono);
+  letter-spacing: 0.12em;
+  color: #8ce5f4;
+  text-shadow: 0 1px #02090f;
+}
+.grid-mobile-game-hud small {
+  display: none;
+}
+.grid-mobile-game .grid-office-viewport {
+  width: 100%;
+  height: 100%;
+  min-height: 0 !important;
+  max-height: none;
+  padding: 0;
+  margin: 0;
+  border: 0;
+  overscroll-behavior: none;
+  scrollbar-width: none;
+}
+.grid-mobile-game .grid-office-viewport::-webkit-scrollbar {
+  display: none;
+}
+.grid-mobile-game .grid-office-canvas-wrap {
+  margin: 0;
+  /* Let the camera track the world edges without pinning the user under the HUD/pad. */
+  padding-block: 45dvh 55dvh;
+}
+.grid-mobile-game .grid-office-viewport > :not(.grid-office-canvas-wrap) {
+  display: none;
+}
+.grid-mobile-game .grid-pad-interact,
+.grid-mobile-game .grid-pad-directions {
+  bottom: max(18px, env(safe-area-inset-bottom, 0px));
+  z-index: 3;
+}
+.grid-mobile-game .grid-pad-directions {
+  right: max(18px, env(safe-area-inset-right, 0px));
+}
+.grid-mobile-game .grid-pad-interact {
+  left: max(18px, env(safe-area-inset-left, 0px));
+  transform: none;
+}
+.grid-mobile-game button {
+  -webkit-touch-callout: none;
+  user-select: none;
+  -webkit-user-select: none;
+}
+.grid-game-active > .grid-main-content,
+.grid-game-active > .grid-mobile-nav {
+  visibility: hidden;
+}
+@media (orientation: landscape) {
+  .grid-mobile-game-hud {
+    padding-top: max(8px, env(safe-area-inset-top, 0px));
+  }
+  .grid-mobile-game-hud small {
+    display: inline;
+    font-size: 8px;
+    color: #84a5b4;
+  }
+}
+
+/* Shared touch controller: every hit area stays inside its own fixed viewport. */
+.grid-game-controls {
+  --grid-control-size: clamp(44px, 13vw, 56px);
+  position: fixed;
+  inset: 0;
+  z-index: 45;
+  pointer-events: none;
+}
+.grid-game-controls,
+.grid-game-controls * {
+  user-select: none;
+  -webkit-user-select: none;
+  -webkit-touch-callout: none;
+  -webkit-user-drag: none;
+  -webkit-tap-highlight-color: transparent;
+  touch-action: none;
+}
+.grid-game-controls .grid-pad-interact,
+.grid-game-controls .grid-pad-directions {
+  position: absolute;
+  bottom: calc(var(--grid-phone-nav, 0px) + max(18px, env(safe-area-inset-bottom, 0px)));
+  pointer-events: none;
+  transform: none;
+}
+.grid-game-controls .grid-pad-interact {
+  left: max(18px, env(safe-area-inset-left, 0px));
+}
+.grid-game-controls .grid-pad-directions {
+  right: max(18px, env(safe-area-inset-right, 0px));
+  display: grid;
+  grid-template-columns: repeat(3, var(--grid-control-size));
+  grid-template-rows: repeat(3, var(--grid-control-size));
+  gap: 6px;
+}
+.grid-game-controls button {
+  pointer-events: auto;
+  margin: 0;
+  min-width: 44px;
+  min-height: 44px;
+  border: 1px solid #86d6e6a0;
+  border-radius: 8px;
+  background: #0b2030ed;
+  color: #d8faff;
+  box-shadow:
+    inset 0 1px #b1ecf51c,
+    0 2px 10px #02080b66;
+}
+.grid-game-direction {
+  width: var(--grid-control-size);
+  height: var(--grid-control-size);
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  font: 18px monospace;
+}
+.grid-game-direction[aria-pressed="true"] {
+  background: #24647c;
+  color: #fff;
+  border-color: #caf9ff;
+  transform: scale(0.97);
+}
+.grid-game-controls button:focus-visible {
+  outline: 2px solid #c9f9ff;
+  outline-offset: 3px;
+}
+.grid-pad-up {
+  grid-area: 1 / 2;
+}
+.grid-pad-left {
+  grid-area: 2 / 1;
+}
+.grid-pad-right {
+  grid-area: 2 / 3;
+}
+.grid-pad-down {
+  grid-area: 3 / 2;
+}
+.grid-game-controls .grid-game-interact {
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  gap: 5px;
+  width: 88px;
+  height: 68px;
+  padding: 10px;
+  background: #f9bb78;
+  border-color: #ffe1b9;
+  color: #15202a;
+}
+.grid-game-interact-label {
+  font: 600 15px monospace;
+}
+.grid-game-interact-hint {
+  font: 8px monospace;
+  letter-spacing: 0.09em;
+}
+.grid-mobile-game .grid-game-controls {
+  position: absolute;
+  z-index: 3;
+}
+.grid-mobile-game .grid-game-controls .grid-pad-interact,
+.grid-mobile-game .grid-game-controls .grid-pad-directions {
+  bottom: max(18px, env(safe-area-inset-bottom, 0px));
+}
+@media (max-height: 430px) and (orientation: landscape) {
+  .grid-game-controls {
+    --grid-control-size: 44px;
+  }
+  .grid-game-controls .grid-pad-directions {
+    gap: 5px;
+  }
+  .grid-game-controls .grid-game-interact {
+    height: 58px;
+  }
+}
+
+.grid-mobile-command .grid-section-label {
+  color: var(--th-text-muted);
+  font: 10px var(--th-font-mono);
+  letter-spacing: 0.12em;
+}

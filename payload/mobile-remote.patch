diff --git a/src/components/office-view/VirtualPadOverlay.test.tsx b/src/components/office-view/VirtualPadOverlay.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..2449e7be79c345a068bfa44175356350dffc81e6
--- /dev/null
+++ b/src/components/office-view/VirtualPadOverlay.test.tsx
@@ -0,0 +1,75 @@
+import { beforeAll, afterAll, describe, expect, it, vi } from "vitest";
+import { fireEvent, render, screen } from "@testing-library/react";
+import VirtualPadOverlay from "./VirtualPadOverlay";
+const originalPointerEvent = window.PointerEvent;
+beforeAll(() => {
+  class TestPointerEvent extends MouseEvent {
+    pointerId: number;
+    constructor(type: string, init: PointerEventInit = {}) {
+      super(type, init);
+      this.pointerId = init.pointerId ?? 1;
+    }
+  }
+  window.PointerEvent = TestPointerEvent as typeof PointerEvent;
+});
+afterAll(() => {
+  window.PointerEvent = originalPointerEvent;
+});
+function setup() {
+  const onSetMoveDirectionPressed = vi.fn();
+  const onInteract = vi.fn();
+  const props = {
+    showVirtualPad: true,
+    t: (text: Record<string, string>) => text.en,
+    onInteract,
+    onSetMoveDirectionPressed,
+  };
+  return { ...render(<VirtualPadOverlay {...props} />), ...props };
+}
+describe("office game held controls", () => {
+  it("captures a hold, cancels native selection, and releases even outside the button", () => {
+    const callbacks = setup();
+    const right = screen.getByRole("button", { name: "Move right" });
+    right.setPointerCapture = vi.fn();
+    expect(fireEvent.pointerDown(right, { pointerId: 7, button: 0, cancelable: true })).toBe(false);
+    expect(right.setPointerCapture).toHaveBeenCalledWith(7);
+    expect(right).toHaveAttribute("aria-pressed", "true");
+    fireEvent.pointerLeave(right, { pointerId: 7 });
+    expect(right).toHaveAttribute("aria-pressed", "true");
+    fireEvent.pointerUp(window, { pointerId: 7 });
+    expect(callbacks.onSetMoveDirectionPressed).toHaveBeenLastCalledWith("right", false);
+    expect(right).toHaveAttribute("aria-pressed", "false");
+    expect(fireEvent.contextMenu(right, { cancelable: true })).toBe(false);
+  });
+  it("preserves another finger on the same direction and releases all input on blur", () => {
+    const callbacks = setup();
+    const right = screen.getByRole("button", { name: "Move right" });
+    const up = screen.getByRole("button", { name: "Move up" });
+    fireEvent.pointerDown(right, { pointerId: 1, button: 0 });
+    fireEvent.pointerDown(right, { pointerId: 2, button: 0 });
+    fireEvent.pointerDown(up, { pointerId: 3, button: 0 });
+    fireEvent.pointerCancel(window, { pointerId: 1 });
+    expect(right).toHaveAttribute("aria-pressed", "true");
+    fireEvent.blur(window);
+    expect(right).toHaveAttribute("aria-pressed", "false");
+    expect(up).toHaveAttribute("aria-pressed", "false");
+    expect(callbacks.onSetMoveDirectionPressed).toHaveBeenCalledWith("up", false);
+    expect(callbacks.onSetMoveDirectionPressed).toHaveBeenCalledWith("right", false);
+  });
+  it("fires interaction once for a touch and still supports keyboard activation", () => {
+    const { onInteract } = setup();
+    const enter = screen.getByRole("button", { name: "Interact" });
+    fireEvent.pointerDown(enter, { button: 0 });

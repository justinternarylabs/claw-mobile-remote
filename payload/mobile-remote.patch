diff --git a/public/claw-sw.js b/public/claw-sw.js
new file mode 100644
index 0000000000000000000000000000000000000000..f528138b77dab5fcba358d574d4e0af1fceaaaae
--- /dev/null
+++ b/public/claw-sw.js
@@ -0,0 +1,44 @@
+/* Push-only service worker: no fetch interception and no API/data caching. */
+self.addEventListener("install", () => self.skipWaiting());
+self.addEventListener("activate", (event) => event.waitUntil(self.clients.claim()));
+
+self.addEventListener("push", (event) => {
+  let payload = {};
+  try {
+    payload = event.data?.json() || {};
+  } catch {
+    /* Show a generic notice. */
+  }
+  const bodies = {
+    complete: "A task is complete. Open your workspace to review it.",
+    failed: "A task needs attention. Open your workspace for details.",
+    decision: "Your decision is needed. Open your workspace to continue.",
+    test: "This device is connected to Claw Empire notifications.",
+  };
+  const body = bodies[payload.kind] || "There is an update in your workspace.";
+  const tag = typeof payload.tag === "string" && /^claw-[a-f0-9]{24}$/.test(payload.tag) ? payload.tag : "claw-update";
+  event.waitUntil(
+    self.registration.showNotification("Claw Empire", {
+      body,
+      tag,
+      icon: "/claw-icon-192.png",
+      badge: "/claw-icon-192.png",
+      data: { url: "/" },
+      renotify: false,
+    }),
+  );
+});
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close();
+  // Never use a URL from a push payload; notifications only open this origin.
+  const target = new URL("/", self.location.origin).href;
+  event.waitUntil(
+    self.clients.matchAll({ type: "window", includeUncontrolled: true }).then(async (clients) => {
+      for (const client of clients) {
+        if (new URL(client.url).origin === self.location.origin && "focus" in client) return client.focus();
+      }
+      return self.clients.openWindow(target);
+    }),
+  );
+});

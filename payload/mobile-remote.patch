@@ -0,0 +1,104 @@
+import { StrictMode } from "react";
+import { act, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import RemoteAccessGate from "./RemoteAccessGate";
+import { bootstrapSession, pairDevice } from "../api/core";
+
+vi.mock("../api/core", () => ({ bootstrapSession: vi.fn(), pairDevice: vi.fn() }));
+beforeEach(() => {
+  vi.clearAllMocks();
+  window.history.replaceState(null, "", "/");
+});
+describe("RemoteAccessGate", () => {
+  it("keeps workspace unmounted until the session is authenticated", async () => {
+    vi.mocked(bootstrapSession).mockResolvedValue(false);
+    render(
+      <RemoteAccessGate>
+        <div>Private workspace</div>
+      </RemoteAccessGate>,
+    );
+    expect(screen.queryByText("Private workspace")).toBeNull();
+    expect(await screen.findByText("Connect your device")).toBeInTheDocument();
+    expect(screen.queryByText("Private workspace")).toBeNull();
+  });
+  it("exchanges the one-time code and opens the workspace", async () => {
+    vi.mocked(bootstrapSession).mockResolvedValue(false);
+    vi.mocked(pairDevice).mockResolvedValue();
+    render(
+      <RemoteAccessGate>
+        <div>Private workspace</div>
+      </RemoteAccessGate>,
+    );
+    await screen.findByText("Connect your device");
+    fireEvent.change(screen.getByLabelText("Pairing code"), { target: { value: "one-time-code" } });
+    fireEvent.click(screen.getByRole("button", { name: "Connect to Claw Empire" }));
+    expect(await screen.findByText("Private workspace")).toBeInTheDocument();
+    expect(pairDevice).toHaveBeenCalledWith("one-time-code", "Mobile device");
+  });
+  it("unmounts workspace when the server rejects a session", async () => {
+    vi.mocked(bootstrapSession).mockResolvedValue(true);
+    render(
+      <RemoteAccessGate>
+        <div>Private workspace</div>
+      </RemoteAccessGate>,
+    );
+    await screen.findByText("Private workspace");
+    fireEvent(window, new Event("claw-auth-required"));
+    await waitFor(() => expect(screen.queryByText("Private workspace")).toBeNull());
+    expect(screen.getByText("Connect your device")).toBeInTheDocument();
+  });
+  it("removes the pairing fragment before any request and waits for an explicit Connect tap", async () => {
+    const code = "Abcdefghijklmnopqrstuvwxyz012345";
+    window.history.replaceState(null, "", `/#pair=${code}`);
+    vi.mocked(bootstrapSession).mockImplementation(async () => {
+      expect(window.location.hash).toBe("");
+      return false;
+    });
+    vi.mocked(pairDevice).mockResolvedValue();
+    render(
+      <StrictMode>
+        <RemoteAccessGate>
+          <div>Private workspace</div>
+        </RemoteAccessGate>
+      </StrictMode>,
+    );
+    await screen.findByText("Connect your device");
+    expect(screen.getByLabelText("Pairing code")).toHaveValue(code);
+    expect(window.location.hash).toBe("");
+    expect(pairDevice).not.toHaveBeenCalled();
+    expect(screen.queryByText("Private workspace")).toBeNull();
+    fireEvent.click(screen.getByRole("button", { name: "Connect to Claw Empire" }));
+    expect(await screen.findByText("Private workspace")).toBeInTheDocument();
+    expect(pairDevice).toHaveBeenCalledWith(code, "Mobile device");
+  });
+  it("hides cached workspace and revalidates immediately on foreground resume", async () => {
+    let finish: (valid: boolean) => void = () => {};
+    vi.mocked(bootstrapSession)
+      .mockResolvedValueOnce(true)
+      .mockImplementationOnce(
+        () =>
+          new Promise<boolean>((resolve) => {
+            finish = resolve;
+          }),
+      );
+    const visible = vi.spyOn(document, "visibilityState", "get").mockReturnValue("visible");
+    try {
+      render(
+        <RemoteAccessGate>
+          <div>Private workspace</div>
+        </RemoteAccessGate>,
+      );
+      await screen.findByText("Private workspace");
+      fireEvent(document, new Event("visibilitychange"));
+      expect(screen.queryByText("Private workspace")).toBeNull();
+      expect(screen.getByText("Checking your connection")).toBeInTheDocument();
+      expect(bootstrapSession).toHaveBeenCalledTimes(2);
+      await act(async () => {
+        finish(false);
+      });
+      expect(await screen.findByText("Connect your device")).toBeInTheDocument();
+    } finally {
+      visible.mockRestore();
+    }
+  });
+});
diff --git a/src/components/RemoteAccessGate.tsx b/src/components/RemoteAccessGate.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c89f6578cf87916113728343df045318b7dfdba5
--- /dev/null
+++ b/src/components/RemoteAccessGate.tsx
@@ -0,0 +1,164 @@
+import { useEffect, useState, type ReactNode, type FormEvent } from "react";
+import { bootstrapSession, pairDevice } from "../api/core";
+
+export default function RemoteAccessGate({ children }: { children: ReactNode }) {
+  const [state, setState] = useState<"checking" | "locked" | "ready">("checking");
+  const [code, setCode] = useState(consumePairingFragment);
+  const [name, setName] = useState("Mobile device");
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState(false);
+  useEffect(() => {
+    let active = true;
+    let revision = 0;
+    const check = () => {
+      const currentRevision = ++revision;
+      void bootstrapSession({ force: true, promptOnUnauthorized: false }).then((ok) => {
+        if (active && currentRevision === revision) setState(ok ? "ready" : "locked");
+      });
+    };
+    const locked = () => {
+      revision++;
+      setState("locked");
+    };
+    const onVisible = () => {
+      if (document.visibilityState !== "visible") return;
+      setState("checking");
+      check();
+    };
+    check();
+    document.addEventListener("visibilitychange", onVisible);
+    window.addEventListener("claw-auth-required", locked);
+    const timer = window.setInterval(() => {
+      if (document.visibilityState === "visible") check();
+    }, 60_000);
+    return () => {
+      active = false;
+      window.removeEventListener("claw-auth-required", locked);
+      document.removeEventListener("visibilitychange", onVisible);
+      window.clearInterval(timer);
+    };
+  }, []);
+  async function submit(event: FormEvent) {
+    event.preventDefault();
+    setBusy(true);
+    setError("");
+    try {
+      await pairDevice(code.trim(), name);
+      setCode("");
+      setState("ready");
+    } catch (reason) {
+      const message = reason instanceof Error ? reason.message : "pairing_failed";
+      setError(
+        message === "too_many_attempts"
+          ? "Too many attempts. Wait one minute and try again."
+          : message === "secure_same_origin_required"
+            ? "Open the private HTTPS address from your desktop setup."
+            : "This code has expired or was already used. Generate a new code on your desktop.",
+      );
+    } finally {
+      setBusy(false);
+    }
+  }
+  if (state === "ready") return <>{children}</>;
+  return (
+    <main
+      style={{
+        minHeight: "100dvh",
+        background: "#060d14",
+        color: "#ddf6ff",
+        display: "grid",
+        placeItems: "center",
+        padding: "24px",
+        fontFamily: "system-ui, sans-serif",
+      }}
+    >
+      <section
+        aria-label="Connect to Claw Empire"
+        style={{ width: "100%", maxWidth: 420, border: "1px solid #285465", padding: "32px", background: "#0c1822" }}
+      >
+        <p style={{ color: "#75e6f5", letterSpacing: ".2em", fontSize: 11 }}>Claw Empire / PRIVATE ACCESS</p>
+        <h1 style={{ fontSize: 26, margin: "20px 0 12px" }}>
+          {state === "checking" ? "Checking your connection" : "Connect your device"}
+        </h1>
+        {state === "checking" ? (
+          <p role="status">Verifying your session…</p>
+        ) : (
+          <form
+            onSubmit={(event) => {
+              void submit(event);
+            }}
+          >
+            <p style={{ color: "#9fb8c7", lineHeight: 1.6, fontSize: 14 }}>
+              On your desktop, open Settings → Remote access and generate a pairing code. Codes expire after five
+              minutes and work once.
+            </p>
+            <label style={{ display: "block", marginTop: 24, fontSize: 13 }}>
+              Device name
+              <input
+                value={name}
+                onChange={(e) => setName(e.target.value)}
+                maxLength={80}
+                autoComplete="off"
+                style={inputStyle}
+              />
+            </label>
+            <label style={{ display: "block", marginTop: 20, fontSize: 13 }}>
+              Pairing code
+              <input
+                value={code}
+                onChange={(e) => setCode(e.target.value)}
+                required
+                autoCapitalize="none"
+                autoCorrect="off"
+                spellCheck={false}
+                autoComplete="off"
+                style={{ ...inputStyle, fontFamily: "monospace" }}
+              />
+            </label>
+            {error && (
+              <p role="alert" style={{ color: "#ff9184", fontSize: 13, lineHeight: 1.5 }}>
+                {error}
+              </p>
+            )}
+            <button
+              disabled={busy}
+              style={{
+                width: "100%",
+                marginTop: 24,
+                padding: "13px",
+                color: "#07121b",
+                background: "#8beaff",
+                border: 0,
+                fontWeight: 700,
+                cursor: "pointer",
+              }}
+            >
+              {busy ? "Connecting…" : "Connect to Claw Empire"}
+            </button>
+          </form>
+        )}
+      </section>
+    </main>
+  );
+}
+const inputStyle = {
+  display: "block",
+  width: "100%",
+  boxSizing: "border-box" as const,
+  marginTop: 8,
+  padding: "12px",
+  border: "1px solid #38586a",
+  background: "#07121b",
+  color: "#e0f8ff",
+  borderRadius: 4,
+  fontSize: 16,
+};
+
+function consumePairingFragment(): string {
+  const params = new URLSearchParams(window.location.hash.slice(1));
+  if (!params.has("pair")) return "";
+  const code = params.get("pair") ?? "";
+  // Fragments stay off HTTP requests; erase the one-time secret before session checks.
+  window.history.replaceState(window.history.state, "", window.location.pathname + window.location.search);
+  return /^[A-Za-z0-9_-]{32}$/.test(code) ? code : "";
+}

+describe("Remote access controls", () => {
+  it("offers sign out without exposing desktop pairing controls to a remote device", async () => {
+    vi.mocked(request).mockResolvedValue({ remote: true });
+    render(<RemoteAccessPanel />);
+    expect(await screen.findByRole("button", { name: "Sign out of this device" })).toBeVisible();
+    expect(screen.queryByRole("button", { name: "Generate pairing code" })).toBeNull();
+    expect(listPairedDevices).not.toHaveBeenCalled();
+  });
+  it("generates a QR locally using a one-time fragment rather than a logged query string", async () => {
+    const code = "Abcdefghijklmnopqrstuvwxyz012345";
+    vi.mocked(request).mockResolvedValue({ remote: false, remote_urls: ["https://my-pc.example.test"] });
+    vi.mocked(listPairedDevices).mockResolvedValue({ ok: true, devices: [] });
+    vi.mocked(createDevicePairing).mockResolvedValue({ ok: true, code, expires_at: Date.now() + 300_000 });
+    vi.mocked(QRCode.toDataURL).mockImplementation(() => Promise.resolve("data:image/png;base64,abc"));
+    render(<RemoteAccessPanel />);
+    await userEvent.click(await screen.findByRole("button", { name: "Generate pairing code" }));
+    expect(await screen.findByAltText("Scan to pair your iPhone with Claw-Empire")).toBeVisible();
+    expect(QRCode.toDataURL).toHaveBeenCalledWith(`https://my-pc.example.test/#pair=${code}`, expect.any(Object));
+    expect(screen.getByLabelText("Pairing code")).toHaveTextContent(code);
+  });
+  it("revokes the selected device and removes it from the local device list", async () => {
+    vi.mocked(request).mockResolvedValue({ remote: false });
+    vi.mocked(listPairedDevices).mockResolvedValue({
+      ok: true,
+      devices: [{ id: "iphone", name: "My phone", created_at: 1, expires_at: Date.now() + 1000, revoked_at: null }],
+    });
+    vi.mocked(revokePairedDevice).mockResolvedValue({ ok: true, revoked: true });
+    render(<RemoteAccessPanel />);
+    await userEvent.click(await screen.findByRole("button", { name: "Revoke" }));
+    await waitFor(() => expect(screen.queryByText("My phone")).toBeNull());
+    expect(revokePairedDevice).toHaveBeenCalledWith("iphone");
+  });
+});
diff --git a/src/components/settings/RemoteAccessPanel.tsx b/src/components/settings/RemoteAccessPanel.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..6893dbca0fb6632ef48d3ac68ba8424fec783caf
--- /dev/null
+++ b/src/components/settings/RemoteAccessPanel.tsx
@@ -0,0 +1,254 @@
+import { useEffect, useState } from "react";
+import {
+  createDevicePairing,
+  listPairedDevices,
+  revokePairedDevice,
+  logoutDevice,
+  request,
+  type PairedDevice,
+} from "../../api/core";
+import GridIcon from "../GridIcon";
+import QRCode from "qrcode";
+
+export default function RemoteAccessPanel() {
+  const [remote, setRemote] = useState<boolean | null>(null);
+  const [devices, setDevices] = useState<PairedDevice[]>([]);
+  const [pairing, setPairing] = useState<{ code: string; expires_at: number } | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [copied, setCopied] = useState(false);
+  const [clock, setClock] = useState(Date.now());
+  const [remoteUrl, setRemoteUrl] = useState("");
+  const [qrCode, setQrCode] = useState("");
+  useEffect(() => {
+    let active = true;
+    request<{ remote: boolean; remote_urls?: string[] }>("/api/auth/session")
+      .then(async (session) => {
+        if (!active) return;
+        setRemote(session.remote);
+        setRemoteUrl(
+          session.remote_urls?.find((url) => {
+            try {
+              return new URL(url).protocol === "https:";
+            } catch {
+              return false;
+            }
+          }) ?? "",
+        );
+        if (!session.remote) {
+          const result = await listPairedDevices();
+          if (active) setDevices(result.devices);
+        }
+      })
+      .catch(() => {
+        if (active) setError("Could not load remote access. Check your connection and retry.");
+      });
+    return () => {
+      active = false;
+    };
+  }, []);
+  useEffect(() => {
+    if (!pairing) return;
+    const timer = window.setInterval(() => setClock(Date.now()), 1000);
+    return () => window.clearInterval(timer);
+  }, [pairing]);
+  useEffect(() => {
+    let active = true;
+    setQrCode("");
+    if (pairing && remoteUrl) {
+      // URL fragments never reach proxy/server access logs. The phone still asks to connect.
+      const url = new URL(remoteUrl);
+      url.hash = `pair=${encodeURIComponent(pairing.code)}`;
+      void QRCode.toDataURL(url.toString(), { width: 224, margin: 3, errorCorrectionLevel: "M" })
+        .then((image) => {
+          if (active) setQrCode(image);
+        })
+        .catch(() => {});
+    }
+    return () => {
+      active = false;
+    };
+  }, [pairing, remoteUrl]);
+
+  async function generate() {
+    setBusy(true);
+    setError("");
+    setCopied(false);
+    try {
+      setPairing(await createDevicePairing());
+      setClock(Date.now());
+    } catch {
+      setError("Pairing codes can only be created from the local desktop. Refresh and try again.");
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function revoke(id: string) {
+    setBusy(true);
+    setError("");
+    try {
+      await revokePairedDevice(id);
+      setDevices((current) => current.filter((device) => device.id !== id));
+    } catch {
+      setError("Could not disconnect this device. Check your connection and try again.");
+    } finally {
+      setBusy(false);
+    }
+  }
+  const seconds = pairing ? Math.max(0, Math.ceil((pairing.expires_at - clock) / 1000)) : 0;
+  return (
+    <section className="grid-access-panel space-y-4" aria-label="Remote access">
+      <div className="flex gap-3 items-center">
+        <span className="grid-cyan">
+          <GridIcon name="disc" />
+        </span>
+        <div>
+          <h3 className="text-sm font-semibold">Remote access</h3>
+          <p className="text-xs mt-1" style={{ color: "var(--th-text-muted)" }}>
+            Your PC. Your phone. A private connection.
+          </p>
+        </div>
+      </div>
+      {remote === null ? (
+        <p className="text-xs" role="status">
+          Checking device access…
+        </p>
+      ) : remote ? (
+        <>
+          <p className="text-xs leading-relaxed">
+            This device is paired. Access expires after 30 days; you can disconnect it here or revoke it from your PC.
+          </p>
+          <button
+            className="grid-access-secondary"
+            disabled={busy}
+            onClick={async () => {
+              setBusy(true);
+              try {
+                await logoutDevice();
+              } catch {
+                setError("Could not sign out. Try again.");
+              } finally {
+                setBusy(false);
+              }
+            }}
+          >
+            Sign out of this device
+          </button>
+        </>
+      ) : (
+        <>
+          <ol className="grid-access-steps text-xs leading-relaxed space-y-2">
+            <li>Connect your PC and iPhone to the same private Tailscale network.</li>
+            <li>
+              On this PC, run <code className="break-all">.\scripts\setup-mobile-access.ps1</code> to prepare your HTTPS
+              address.
+            </li>
+            <li>
+              Generate a code, then scan the QR with your iPhone camera and tap Connect. Or enter the code manually.
+            </li>
+          </ol>
+          {remoteUrl && (
+            <div className="text-xs">
+              <span style={{ color: "var(--th-text-muted)" }}>Your private address</span>
+              <a href={remoteUrl} className="block grid-cyan break-all mt-1" rel="noreferrer">
+                {remoteUrl}
+              </a>
+            </div>
+          )}
+          <button className="grid-access-primary" onClick={() => void generate()} disabled={busy}>
+            {busy ? "Working…" : "Generate pairing code"}
+          </button>
+          {pairing && (
+            <div className="grid-access-hint space-y-2">
+              {seconds > 0 ? (
+                <>
+                  <p className="text-xs">
+                    One use · expires in {Math.floor(seconds / 60)}:{String(seconds % 60).padStart(2, "0")}
+                  </p>
+                  {qrCode && (
+                    <img
+                      src={qrCode}
+                      width={224}
+                      height={224}
+                      alt="Scan to pair your iPhone with Claw-Empire"
+                      className="max-w-full"
+                    />
+                  )}
+                  <code className="block break-all select-all text-sm tracking-wider" aria-label="Pairing code">
+                    {pairing.code}
+                  </code>
+                  <button
+                    className="grid-access-secondary"
+                    onClick={async () => {
+                      try {
+                        await navigator.clipboard.writeText(pairing.code);
+                        setCopied(true);
+                      } catch {
+                        setError("Select and copy the code manually.");
+                      }
+                    }}
+                  >
+                    {copied ? "Copied" : "Copy code"}
+                  </button>
+                </>
+              ) : (
+                <p className="text-xs">This code has expired. Generate a new one.</p>
+              )}
+            </div>
+          )}
+          <div>
+            <div className="flex items-center justify-between gap-3 mb-2">
+              <h4 className="text-xs font-semibold">Paired devices</h4>
+              <button
+                className="grid-access-secondary"
+                disabled={busy}
+                onClick={async () => {
+                  setBusy(true);
+                  try {
+                    setDevices((await listPairedDevices()).devices);
+                  } catch {
+                    setError("Could not refresh devices.");
+                  } finally {
+                    setBusy(false);
+                  }
+                }}
+              >
+                Refresh devices
+              </button>
+            </div>
+            {devices.length === 0 ? (
+              <p className="text-xs" style={{ color: "var(--th-text-muted)" }}>
+                No phones or remote browsers paired yet.
+              </p>
+            ) : (
+              <ul className="space-y-2">
+                {devices.map((device) => (
+                  <li key={device.id} className="flex items-center justify-between gap-3">
+                    <div className="min-w-0">
+                      <p className="text-xs truncate">{device.name}</p>
+                      <p className="text-[10px] mt-1" style={{ color: "var(--th-text-muted)" }}>
+                        Expires {new Date(device.expires_at).toLocaleDateString()}
+                      </p>
+                    </div>
+                    <button className="grid-access-secondary" disabled={busy} onClick={() => void revoke(device.id)}>
+                      Revoke
+                    </button>
+                  </li>
+                ))}
+              </ul>
+            )}
+          </div>
+        </>
+      )}
+      <p className="text-[11px] leading-relaxed" style={{ color: "var(--th-text-muted)" }}>
+        Use private HTTPS access. No router port forwarding is required. Your PC must be awake and Claw-Empire must be
+        running.
+      </p>
+      {error && (
+        <p role="alert" className="text-xs text-red-400">
+          {error}
+        </p>
+      )}
+    </section>
+  );
+}

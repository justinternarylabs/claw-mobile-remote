+import { describe, expect, it, vi } from "vitest";
+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import type { ComponentProps } from "react";
+import type { Agent, Task } from "../types";
+import GridMobileCommand from "./GridMobileCommand";
+import GridMobileNav from "./GridMobileNav";
+
+const agent = { id: "program", name: "Mina", name_ko: "Mina", status: "working", sprite_number: 1 } as Agent;
+function props(): ComponentProps<typeof GridMobileCommand> {
+  return {
+    connected: true,
+    agents: [agent],
+    departments: [],
+    tasks: [],
+    decisionCount: 2,
+    onDecisions: vi.fn(),
+    onAgent: vi.fn(),
+    onTasks: vi.fn(),
+    onBroadcast: vi.fn(),
+    onTerminal: vi.fn(),
+    onPause: vi.fn().mockResolvedValue(undefined),
+    onResume: vi.fn().mockResolvedValue(undefined),
+  };
+}
+describe("phone command controls", () => {
+  it("uses real pending/in-progress task status for resume/pause and hides archived work", async () => {
+    const user = userEvent.setup();
+    const callbacks = props();
+    callbacks.tasks = [
+      { id: "run", title: "Compile sector", status: "in_progress", assigned_agent_id: agent.id },
+      { id: "hold", title: "Restore uplink", status: "pending" },
+      { id: "hidden", title: "Hidden", status: "in_progress", hidden: 1 },
+      { id: "done", title: "Finished", status: "done" },
+    ] as Task[];
+    render(<GridMobileCommand {...callbacks} />);
+    expect(screen.queryByText("Hidden")).not.toBeInTheDocument();
+    expect(screen.queryByText("Finished")).not.toBeInTheDocument();
+    await user.click(screen.getByRole("button", { name: "Pause" }));
+    expect(callbacks.onPause).toHaveBeenCalledWith("run");
+    await user.click(screen.getByRole("button", { name: "Resume" }));
+    expect(callbacks.onResume).toHaveBeenCalledWith("hold");
+    await user.click(screen.getByRole("button", { name: /2 decisions need you/ }));
+    expect(callbacks.onDecisions).toHaveBeenCalled();
+    await user.click(screen.getByRole("button", { name: /Mina/ }));
+    expect(callbacks.onAgent).toHaveBeenCalledWith(agent);
+  });
+  it("shows a failed control request inline and re-enables controls", async () => {
+    const user = userEvent.setup();
+    const callbacks = props();
+    callbacks.tasks = [{ id: "run", title: "Compile sector", status: "in_progress" }] as Task[];
+    callbacks.onPause = vi.fn().mockRejectedValue(new Error("Uplink unavailable"));
+    render(<GridMobileCommand {...callbacks} />);
+    await user.click(screen.getByRole("button", { name: "Pause" }));
+    expect(screen.getByRole("alert")).toHaveTextContent("Uplink unavailable");
+    expect(screen.getByRole("button", { name: "Pause" })).toBeEnabled();
+  });
+  it("makes Dashboard and Settings available from More and supports dismissing the sheet", async () => {
+    const user = userEvent.setup();
+    const onNavigate = vi.fn();
+    render(
+      <GridMobileNav
+        view="office"
+        onNavigate={onNavigate}
+        onReports={vi.fn()}
+        onDecisions={vi.fn()}
+        onBroadcast={vi.fn()}
+        onStatus={vi.fn()}
+        onRooms={vi.fn()}
+        decisionCount={0}
+      />,
+    );
+    await user.click(screen.getByRole("button", { name: "More navigation and controls" }));
+    expect(screen.getByRole("dialog", { name: "Office controls" })).toBeInTheDocument();
+    await user.click(screen.getByRole("button", { name: /Dashboard/ }));
+    expect(onNavigate).toHaveBeenCalledWith("dashboard");
+    expect(screen.queryByRole("dialog")).not.toBeInTheDocument();
+    await user.click(screen.getByRole("button", { name: "More navigation and controls" }));
+    await user.keyboard("{Escape}");
+    expect(screen.queryByRole("dialog")).not.toBeInTheDocument();

+.grid-access-panel {
+  padding: 24px;
+  background: var(--th-card-bg);
+  border: 1px solid var(--th-card-border);
+  border-radius: 4px;
+}
+.grid-access-primary,
+.grid-access-secondary {
+  min-height: 44px;
+  padding: 10px 15px;
+  border-radius: 3px;
+  font-size: 12px;
+  cursor: pointer;
+}
+.grid-access-primary {
+  color: #ffffff;
+  background: var(--claw-mobile-button, #2563eb);
+  border: 1px solid var(--claw-mobile-button, #2563eb);
+}
+.grid-access-secondary {
+  background: transparent;
+  border: 1px solid var(--th-border-strong);
+  color: var(--th-text-primary);
+}
+.grid-access-primary:disabled,
+.grid-access-secondary:disabled {
+  opacity: 0.5;

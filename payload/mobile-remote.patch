diff --git a/server/notifications/push-service.test.ts b/server/notifications/push-service.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0708e4861420b31db87066bfd7d8a90f4450229f
--- /dev/null
+++ b/server/notifications/push-service.test.ts
@@ -0,0 +1,371 @@
+import express from "express";
+import request from "supertest";
+import { DatabaseSync } from "node:sqlite";
+import { createECDH, randomBytes } from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import vm from "node:vm";
+import https from "node:https";
+import { EventEmitter } from "node:events";
+import type { ClientRequest, IncomingMessage } from "node:http";
+import webpush from "web-push";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { SESSION_AUTH_TOKEN, SESSION_COOKIE_NAME } from "../config/runtime.ts";
+import {
+  createPushService,
+  validatePushSubscription,
+  loadVapidKeys,
+  describePushFailure,
+  resolvePushSubject,
+} from "./push-service.ts";
+
+const token = () => randomBytes(32).toString("base64url");
+const subscription = (suffix = "device") => {
+  const ecdh = createECDH("prime256v1");
+  ecdh.generateKeys();
+  return {
+    endpoint: `https://web.push.apple.com/${suffix}`,
+    keys: { p256dh: ecdh.getPublicKey().toString("base64url"), auth: randomBytes(16).toString("base64url") },
+  };
+};
+const databases: DatabaseSync[] = [];
+afterEach(() => {
+  for (const db of databases.splice(0)) db.close();
+  vi.restoreAllMocks();
+});
+
+function harness() {
+  const app = express();
+  app.use(express.json());
+  const db = new DatabaseSync(":memory:");
+  databases.push(db);
+  const send = vi.fn().mockResolvedValue({ statusCode: 201 });
+  const revoked = new Set<string>();
+  const keys = webpush.generateVAPIDKeys();
+  const service = createPushService({
+    app,
+    db,
+    vapidKeys: keys,
+    vapidSubject: "https://claw.example.ts.net",
+    nowMs: () => 100_000,
+    sendNotification: send,
+    getOwnerSessionId: (req) => req.header("x-test-owner") || null,
+    isOwnerSessionActive: (id) => !revoked.has(id),
+  });
+  const api = (method: "get" | "post", route: string, body?: unknown, owner?: string) => {
+    let call = request(app)[method](route).set("authorization", `Bearer ${SESSION_AUTH_TOKEN}`);
+    if (owner) call = call.set("x-test-owner", owner);
+    return body ? call.send(body) : call;
+  };
+  return { app, db, send, keys, service, api, revoked };
+}
+
+describe("private device push service", () => {
+  it("uses the real production sender with encrypted payload and VAPID headers without reaching the network", async () => {
+    const writes = vi.fn();
+    const transport = vi.spyOn(https, "request").mockImplementation(((
+      _options: unknown,
+      callback: (response: IncomingMessage) => void,
+    ) => {
+      const response = Object.assign(new EventEmitter(), { statusCode: 201, headers: {} });
+      const outgoing = Object.assign(new EventEmitter(), {
+        write: writes,
+        end: () => {
+          callback(response as IncomingMessage);
+          response.emit("end");
+        },
+        destroy: vi.fn(),
+      });
+        return outgoing as unknown as ClientRequest;
+    }) as typeof https.request);
+    const app = express();
+    app.use(express.json());
+    const db = new DatabaseSync(":memory:");
+    databases.push(db);
+    createPushService({ app, db, vapidKeys: webpush.generateVAPIDKeys(), vapidSubject: "https://claw.example.ts.net" });
+    const deviceToken = token();
+    const auth = { authorization: `Bearer ${SESSION_AUTH_TOKEN}` };
+    await request(app)
+      .post("/api/push/subscribe")
+      .set(auth)
+      .send({ deviceToken, subscription: subscription() })
+      .expect(200);
+    await request(app).post("/api/push/test").set(auth).send({ deviceToken }).expect(200, { ok: true, sent: true });
+    expect(transport).toHaveBeenCalledTimes(1);
+    const options = transport.mock.calls[0][0] as https.RequestOptions;
+    expect(options.hostname).toBe("web.push.apple.com");
+    expect(String((options.headers as Record<string, unknown>).Authorization)).toMatch(/^vapid t=/);
+    const authorization = String((options.headers as Record<string, unknown>).Authorization);
+    const jwt = authorization.match(/t=([^,]+)/)![1];
+    expect(JSON.parse(Buffer.from(jwt.split(".")[1], "base64url").toString("utf8")).sub).toBe(
+      "https://claw.example.ts.net",
+    );

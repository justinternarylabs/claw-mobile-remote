+              Dashboard<span>Live performance</span>
+            </button>
+            <button onClick={() => run(props.onDecisions)}>
+              <GridIcon name="disc" />
+              Decisions<span>{props.decisionCount ? `${props.decisionCount} awaiting you` : "All clear"}</span>
+            </button>
+            <button onClick={() => run(props.onBroadcast)}>
+              <GridIcon name="broadcast" />
+              Broadcast<span>Message every program</span>
+            </button>
+            <button onClick={() => run(props.onStatus)}>
+              <GridIcon name="signal" />
+              Agent status
+            </button>
+            <button onClick={() => run(props.onReports)}>
+              <GridIcon name="skills" />
+              Reports
+            </button>
+            <button onClick={() => run(props.onRooms)}>
+              <GridIcon name="office" />
+              Department appearance
+            </button>
+            <button onClick={() => run(() => props.onNavigate("settings"))}>
+              <GridIcon name="settings" />
+              Settings<span>Connections and preferences</span>
+            </button>
+          </div>
+        </div>
+      )}
+    </>
+  );
+}

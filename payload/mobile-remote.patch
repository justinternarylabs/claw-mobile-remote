new file mode 100644
index 0000000000000000000000000000000000000000..712bdc94e038e571d53a51d5cc5323497f258b8c
--- /dev/null
+++ b/src/components/GridMobileCommand.tsx
@@ -0,0 +1,142 @@
+import { useState } from "react";
+import type { Agent, Department, Task } from "../types";
+import { localeName, useI18n } from "../i18n";
+import AgentAvatar from "./AgentAvatar";
+import GridIcon from "./GridIcon";
+
+type Props = {
+  connected: boolean;
+  agents: Agent[];
+  departments: Department[];
+  tasks: Task[];
+  decisionCount: number;
+  onDecisions: () => void;
+  onAgent: (agent: Agent) => void;
+  onTasks: () => void;
+  onBroadcast: () => void;
+  onTerminal: (taskId: string) => void;
+  onPause: (taskId: string) => Promise<void>;
+  onResume: (taskId: string) => Promise<void>;
+};
+
+export default function GridMobileCommand(props: Props) {
+  const { locale } = useI18n();
+  const [busy, setBusy] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const active = props.tasks.filter(
+    (task) => !task.hidden && ["in_progress", "collaborating", "review", "pending"].includes(task.status),
+  );
+  const working = props.agents.filter((agent) => agent.status === "working").length;
+  const unread = active.filter((task) => task.status === "review").length;
+  const control = async (task: Task) => {
+    if (busy) return;
+    setBusy(task.id);
+    setError(null);
+    try {
+      await (task.status === "pending" ? props.onResume(task.id) : props.onPause(task.id));
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : "Command could not be sent. Try again.");
+    } finally {
+      setBusy(null);
+    }
+  };
+  return (
+    <section className="grid-mobile-command" aria-label="Mobile command overview">
+      <div className="grid-mobile-welcome">
+        <div>
+          <span className="grid-section-label">REMOTE COMMAND</span>
+          <h2>Your office, wherever you work.</h2>
+        </div>
+        <span className={props.connected ? "grid-mobile-link" : "grid-mobile-link offline"}>
+          {props.connected ? "LINKED" : "OFFLINE"}
+        </span>
+      </div>
+      <div className="grid-mobile-counts">
+        <div>
+          <strong>{working}</strong>
+          <span>Executing</span>
+        </div>
+        <div>
+          <strong>{active.length}</strong>
+          <span>Active tasks</span>
+        </div>
+        <div>
+          <strong>{unread}</strong>
+          <span>In review</span>
+        </div>
+      </div>
+      <button className={`grid-mobile-decision ${props.decisionCount ? "pending" : ""}`} onClick={props.onDecisions}>
+        <GridIcon name="disc" size={23} />
+        <span>
+          <strong>
+            {props.decisionCount ? `${props.decisionCount} decisions need you` : "Decision channel clear"}
+          </strong>
+          <small>{props.decisionCount ? "Review and approve the next step" : "Open your decision inbox"}</small>
+        </span>
+        <span aria-hidden="true">›</span>
+      </button>
+      <div className="grid-mobile-quick">
+        <button onClick={props.onTasks}>
+          <GridIcon name="tasks" />
+          Manage tasks
+        </button>
+        <button onClick={props.onBroadcast}>
+          <GridIcon name="broadcast" />
+          Broadcast
+        </button>
+      </div>
+      <div className="grid-mobile-section-title">
+        <h3>Active tasks</h3>
+        <button onClick={props.onTasks}>View all →</button>
+      </div>
+      {error && (
+        <p className="grid-mobile-command-error" role="alert">
+          {error}
+        </p>
+      )}
+      {active.length === 0 ? (
+        <div className="grid-mobile-empty">
+          <GridIcon name="signal" size={24} />
+          <p>No active tasks.</p>
+          <button onClick={props.onTasks}>Create or assign a task</button>
+        </div>
+      ) : (
+        active.slice(0, 6).map((task) => {
+          const agent = props.agents.find((item) => item.id === task.assigned_agent_id);
+          return (
+            <article className="grid-mobile-task" key={task.id}>
+              <span className="grid-mobile-task-status">{task.status.replaceAll("_", " ")}</span>
+              <h4>{task.title}</h4>
+              <p>{agent ? localeName(locale, agent) : "Awaiting assignment"}</p>
+              <div>
+                <button onClick={() => props.onTerminal(task.id)}>Open activity</button>
+                {["in_progress", "pending"].includes(task.status) && (
+                  <button disabled={busy !== null} onClick={() => void control(task)}>
+                    {busy === task.id ? "Sending…" : task.status === "pending" ? "Resume" : "Pause"}
+                  </button>
+                )}
+              </div>
+            </article>
+          );
+        })
+      )}
+      <div className="grid-mobile-section-title">
+        <h3>Agents</h3>
+        <span>{props.agents.length} available agents</span>
+      </div>
+      <div className="grid-mobile-programs">
+        {props.agents.map((agent) => (
+          <button key={agent.id} onClick={() => props.onAgent(agent)}>
+            <AgentAvatar agent={agent} size={42} />
+            <span>
+              <strong>{localeName(locale, agent)}</strong>
+              <small>{props.departments.find((dept) => dept.id === agent.department_id)?.name || "Independent"}</small>
+            </span>
+            <span className={`grid-mobile-program-status ${agent.status}`}>{agent.status}</span>
+            <span aria-hidden="true">›</span>
+          </button>
+        ))}
+      </div>
+    </section>
+  );
+}

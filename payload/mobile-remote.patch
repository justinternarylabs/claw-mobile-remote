+          aria-expanded={open}
+          aria-controls="grid-mobile-more"
+          aria-current={props.view === "settings" || props.view === "dashboard" ? "page" : undefined}
+          onClick={() => setOpen(!open)}
+        >
+          <GridIcon name="settings" size={21} />
+          <span>More</span>
+          {props.decisionCount > 0 && <i className="grid-mobile-alert" />}

+}
+.grid-access-hint {
+  border: 1px solid var(--th-border-strong);
+  background: var(--th-bg-surface);
+  padding: 16px;
+}
+.grid-access-steps {
+  list-style: decimal;
+  padding-left: 18px;
+  color: var(--th-text-secondary);
+}
+@media (max-width: 640px) {
+  .grid-access-panel {
+    padding: 18px;
+  }
+}
+
+.grid-access-panel .grid-cyan {
+  color: var(--claw-mobile-accent, #60a5fa);
+}

+import fs from "node:fs";
+import path from "node:path";
+import { createHash, createECDH } from "node:crypto";
+import type { DatabaseSync } from "node:sqlite";
+import type { Express, Request, Response, NextFunction } from "express";
+import webpush from "web-push";
+import { isAuthenticated, hasValidCsrfToken, shouldRequireCsrf } from "../security/auth.ts";
+import { ALLOWED_ORIGINS } from "../config/runtime.ts";
+
+type VapidKeys = { publicKey: string; privateKey: string };
+type Subscription = { endpoint: string; keys: { p256dh: string; auth: string } };
+type PushRow = {
+  device_hash: string;
+  owner_session_id: string | null;
+  subscription_json: string;
+  last_test_at: number;
+};
+type PushKind = "complete" | "failed" | "decision" | "test";
+type PushDeliveryResult = { sent: boolean; error?: string; message?: string };
+type PushDeps = {
+  app: Express;
+  db: DatabaseSync;
+  keysPath?: string;
+  vapidKeys?: VapidKeys;
+  vapidSubject?: string;
+  nowMs?: () => number;
+  getOwnerSessionId?: (req: Request) => string | null;
+  isOwnerSessionActive?: (sessionId: string) => boolean;
+  sendNotification?: typeof webpush.sendNotification;
+};
+
+const MAX_DEVICES = 20;
+const DEVICE_TOKEN = /^[A-Za-z0-9_-]{43,128}$/;
+const digest = (text: string) => createHash("sha256").update(text).digest("hex");
+
+export function resolvePushSubject(explicit: string | undefined, origins: string[] = ALLOWED_ORIGINS): string | null {
+  const valid = (value: string): boolean => {
+    try {
+      const url = new URL(value);
+      if (url.protocol === "mailto:")
+        return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(url.pathname) && !/\.(?:local|localhost)$/i.test(url.pathname);
+      return (
+        url.protocol === "https:" &&
+        !url.username &&
+        !url.password &&
+        !["localhost", "127.0.0.1", "[::1]"].includes(url.hostname.toLowerCase()) &&
+        !url.hostname.toLowerCase().endsWith(".localhost")
+      );
+    } catch {
+      return false;
+    }
+  };
+  if (explicit?.trim()) return valid(explicit.trim()) ? explicit.trim() : null;
+  return origins.find((origin) => origin.startsWith("https:") && valid(origin)) ?? null;
+}
+const PUSH_PROVIDER_REASONS = new Set([
+  "BadJwtToken",
+  "BadAuthorizationHeader",
+  "InvalidProviderToken",
+  "ExpiredProviderToken",
+  "Forbidden",
+  "BadCryptoKey",
+  "BadEncryption",
+  "BadTtl",
+  "BadWebPushRequest",
+  "MissingCryptoKeys",
+  "Unregistered",
+  "NotFound",
+  "TooManyRequests",
+  "BadExpirationTime",
+  "DeviceTokenNotForTopic",
+]);
+const PUSH_NETWORK_CODES = new Set([
+  "ENOTFOUND",
+  "EAI_AGAIN",
+  "ECONNREFUSED",
+  "ECONNRESET",
+  "ETIMEDOUT",
+  "ENETUNREACH",
+  "EHOSTUNREACH",
+  "CERT_HAS_EXPIRED",
+  "UNABLE_TO_VERIFY_LEAF_SIGNATURE",
+]);
+
+export function describePushFailure(error: unknown) {
+  const failure =
+    error && typeof error === "object"
+      ? (error as { statusCode?: unknown; code?: unknown; body?: unknown; message?: unknown })
+      : {};
+  const statusCode =
+    typeof failure.statusCode === "number" &&
+    Number.isInteger(failure.statusCode) &&
+    failure.statusCode >= 100 &&
+    failure.statusCode <= 599
+      ? failure.statusCode
+      : null;
+  const code =
+    typeof failure.code === "string" && PUSH_NETWORK_CODES.has(failure.code) ? failure.code : "PUSH_SEND_ERROR";
+  let reason: string | null = null;
+  try {
+    const parsed = typeof failure.body === "string" && failure.body.length <= 4096 ? JSON.parse(failure.body) : null;
+    if (typeof parsed?.reason === "string" && PUSH_PROVIDER_REASONS.has(parsed.reason)) reason = parsed.reason;
+  } catch {
+    /* Unrecognized provider responses must never be logged. */
+  }
+  let result: PushDeliveryResult = {
+    sent: false,
+    error: "push_delivery_failed",
+    message: "The notification could not be delivered. Try again in a minute.",
+  };
+  if (statusCode === 404 || statusCode === 410 || reason === "Unregistered") {
+    result = {
+      sent: false,
+      error: "push_subscription_expired",
+      message: "This notification subscription expired. Disable notifications, then enable them again on this device.",
+    };
+  } else if (statusCode === 401 || statusCode === 403) {
+    result = {
+      sent: false,
+      error: "push_provider_auth_failed",
+      message:
+        "The push provider rejected this server's credentials. Review the server push configuration and try again.",
+    };
+  } else if (statusCode === 429) {
+    result = {
+      sent: false,
+      error: "push_rate_limited",
+      message: "The push provider is busy. Wait a minute before testing again.",
+    };
+  } else if (
+    PUSH_NETWORK_CODES.has(code) ||
+    (typeof failure.message === "string" && failure.message === "Socket timeout")
+  ) {
+    result = {
+      sent: false,
+      error: "push_network_unavailable",
+      message: "The server could not reach the push provider. Check its internet connection and try again.",
+    };
+  } else if (statusCode && statusCode >= 500) {
+    result = {
+      sent: false,
+      error: "push_provider_unavailable",
+      message: "The push provider is temporarily unavailable. Try again later.",
+    };
+  }
+  return { result, diagnostic: { statusCode, code, reason } };
+}
+
+function validBase64(value: unknown, length: number): value is string {
+  return (
+    typeof value === "string" && /^[A-Za-z0-9_-]+$/.test(value) && Buffer.from(value, "base64url").length === length
+  );
+}
+
+export function validatePushSubscription(value: unknown): Subscription | null {
+  if (!value || typeof value !== "object") return null;
+  const input = value as Partial<Subscription>;
+  if (typeof input.endpoint !== "string" || input.endpoint.length > 2048) return null;
+  try {
+    const url = new URL(input.endpoint);
+    const host = url.hostname.toLowerCase();
+    const approved =
+      host === "fcm.googleapis.com" ||
+      host === "updates.push.services.mozilla.com" ||
+      host.endsWith(".push.services.mozilla.com") ||
+      host === "web.push.apple.com" ||
+      host.endsWith(".push.apple.com") ||
+      host.endsWith(".notify.windows.com");
+    if (
+      !approved ||
+      url.protocol !== "https:" ||
+      url.port ||
+      url.username ||
+      url.password ||
+      url.hash ||
+      url.pathname === "/"
+    )
+      return null;
+    if (!validBase64(input.keys?.auth, 16) || !validBase64(input.keys?.p256dh, 65)) return null;
+    // Reject malformed/non-curve browser encryption keys before storing them.
+    const ecdh = createECDH("prime256v1");
+    ecdh.generateKeys();
+    ecdh.computeSecret(Buffer.from(input.keys.p256dh, "base64url"));
+    return { endpoint: url.toString(), keys: { auth: input.keys.auth, p256dh: input.keys.p256dh } };
+  } catch {
+    return null;
+  }
+}
+
+function validateVapidKeys(value: VapidKeys): VapidKeys {
+  if (!validBase64(value.publicKey, 65) || !validBase64(value.privateKey, 32)) throw new Error("invalid_push_keys");
+  const key = createECDH("prime256v1");
+  key.setPrivateKey(Buffer.from(value.privateKey, "base64url"));
+  if (key.getPublicKey().toString("base64url") !== value.publicKey) throw new Error("invalid_push_keys");
+  return value;
+}
+
+export function loadVapidKeys(filename: string): VapidKeys {
+  if (fs.existsSync(filename)) return validateVapidKeys(JSON.parse(fs.readFileSync(filename, "utf8")));
+  fs.mkdirSync(path.dirname(filename), { recursive: true, mode: 0o700 });
+  const keys = webpush.generateVAPIDKeys();
+  try {
+    fs.writeFileSync(filename, JSON.stringify(keys), { flag: "wx", mode: 0o600 });
+    return keys;
+  } catch (error: any) {
+    if (error?.code === "EEXIST") return validateVapidKeys(JSON.parse(fs.readFileSync(filename, "utf8")));
+    throw error;
+  }
+}
+
+export function createPushService(deps: PushDeps) {

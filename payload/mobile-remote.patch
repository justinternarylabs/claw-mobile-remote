diff --git a/server/security/device-sessions.ts b/server/security/device-sessions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..393590855e597f9e823f96ad5683517830ef2145
--- /dev/null
+++ b/server/security/device-sessions.ts
@@ -0,0 +1,134 @@
+import { createHash, randomBytes, randomUUID } from "node:crypto";
+import { DatabaseSync } from "node:sqlite";
+import path from "node:path";
+import { DEFAULT_DATA_ROOT } from "../config/runtime.ts";
+
+export const DEVICE_COOKIE_NAME = "__Host-claw_device";
+export const DEVICE_SESSION_MS = 30 * 24 * 60 * 60 * 1000;
+export const PAIRING_TTL_MS = 5 * 60 * 1000;
+export const hashDeviceSecret = (secret: string): string => createHash("sha256").update(secret).digest("hex");
+export const deviceCsrfToken = (token: string): string => hashDeviceSecret(`claw-device-csrf:${token}`);
+export interface DeviceSession {
+  id: string;
+  name: string;
+  created_at: number;
+  expires_at: number;
+  revoked_at: number | null;
+}
+
+export class DeviceSessionStore {
+  readonly db: DatabaseSync;
+  private revokedListeners = new Set<(id: string) => void>();
+  constructor(
+    filename: string,
+    readonly now: () => number = Date.now,
+  ) {
+    this.db = new DatabaseSync(filename);
+    this.db.exec(`PRAGMA busy_timeout=5000;
+      CREATE TABLE IF NOT EXISTS device_sessions (id TEXT PRIMARY KEY, token_hash TEXT NOT NULL UNIQUE, name TEXT NOT NULL,
+      created_at INTEGER NOT NULL, expires_at INTEGER NOT NULL, revoked_at INTEGER);
+      CREATE TABLE IF NOT EXISTS pairing_codes (code_hash TEXT PRIMARY KEY, expires_at INTEGER NOT NULL);
+    `);
+  }
+  createPairing(): { code: string; expires_at: number } {
+    const code = randomBytes(24).toString("base64url");
+    const expires_at = this.now() + PAIRING_TTL_MS;
+    this.db.exec("BEGIN IMMEDIATE");
+    try {
+      this.db.exec("DELETE FROM pairing_codes");
+      this.db.prepare("INSERT INTO pairing_codes VALUES (?,?)").run(hashDeviceSecret(code), expires_at);
+      this.db.exec("COMMIT");
+    } catch (error) {
+      this.db.exec("ROLLBACK");
+      throw error;
+    }
+    return { code, expires_at };
+  }
+  redeem(code: string, name: string): { token: string; session: DeviceSession } | null {
+    if (!/^[A-Za-z0-9_-]{32}$/.test(code)) return null;
+    this.db.exec("BEGIN IMMEDIATE");
+    try {
+      const result = this.db
+        .prepare("DELETE FROM pairing_codes WHERE code_hash = ? AND expires_at > ? RETURNING code_hash")
+        .get(hashDeviceSecret(code), this.now());
+      if (!result) {
+        this.db.exec("ROLLBACK");
+        return null;
+      }
+      this.db.prepare("DELETE FROM device_sessions WHERE expires_at <= ? OR revoked_at IS NOT NULL").run(this.now());
+      const count = this.db.prepare("SELECT COUNT(*) AS count FROM device_sessions").get() as { count: number };
+      if (count.count >= 20) throw new Error("device_limit_reached");
+      const token = randomBytes(32).toString("base64url");
+      const session: DeviceSession = {
+        id: randomUUID(),
+        name:
+          Array.from(name)
+            .filter((character) => character.charCodeAt(0) >= 32 && character.charCodeAt(0) !== 127)
+            .join("")
+            .trim()
+            .slice(0, 80) || "Mobile device",
+        created_at: this.now(),
+        expires_at: this.now() + DEVICE_SESSION_MS,
+        revoked_at: null,
+      };
+      this.db
+        .prepare("INSERT INTO device_sessions VALUES (?,?,?,?,?,NULL)")
+        .run(session.id, hashDeviceSecret(token), session.name, session.created_at, session.expires_at);
+      this.db.exec("COMMIT");
+      return { token, session };
+    } catch (error) {
+      this.db.exec("ROLLBACK");
+      throw error;
+    }
+  }
+  get(token: string | null | undefined): DeviceSession | null {
+    if (!token || token.length !== 43) return null;
+    return (
+      (this.db
+        .prepare(
+          "SELECT id,name,created_at,expires_at,revoked_at FROM device_sessions WHERE token_hash = ? AND revoked_at IS NULL AND expires_at > ?",
+        )
+        .get(hashDeviceSecret(token), this.now()) as unknown as DeviceSession) ?? null
+    );
+  }
+  getById(id: string): DeviceSession | null {
+    return (
+      (this.db
+        .prepare(
+          "SELECT id,name,created_at,expires_at,revoked_at FROM device_sessions WHERE id = ? AND revoked_at IS NULL AND expires_at > ?",
+        )
+        .get(id, this.now()) as unknown as DeviceSession) ?? null
+    );
+  }
+  list(): DeviceSession[] {
+    return this.db
+      .prepare(
+        "SELECT id,name,created_at,expires_at,revoked_at FROM device_sessions WHERE revoked_at IS NULL AND expires_at > ? ORDER BY created_at DESC",
+      )
+      .all(this.now()) as unknown as DeviceSession[];
+  }
+  revoke(id: string): boolean {
+    const result = this.db
+      .prepare("UPDATE device_sessions SET revoked_at = ? WHERE id = ? AND revoked_at IS NULL")
+      .run(this.now(), id);
+    if (result.changes) for (const listener of this.revokedListeners) listener(id);
+    return Boolean(result.changes);
+  }
+  onRevoke(listener: (id: string) => void): () => void {
+    this.revokedListeners.add(listener);
+    return () => {
+      this.revokedListeners.delete(listener);
+    };
+  }
+  close(): void {
+    this.db.close();
+  }
+}
+
+let store: DeviceSessionStore | undefined;
+export function getDeviceSessionStore(): DeviceSessionStore {
+  return (store ??= new DeviceSessionStore(
+    process.env.REMOTE_AUTH_DB_PATH ||
+      `${process.env.DB_PATH || path.join(DEFAULT_DATA_ROOT, "claw-empire.sqlite")}.remote-auth.sqlite`,
+  ));
+}

+import { StrictMode } from "react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { fireEvent, render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import GridMobileGame from "./GridMobileGame";
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  window.history.replaceState(null, "");
+});
+
+describe("full-screen office navigation", () => {
+  it("portals beyond scrolling ancestors and adds one history entry under StrictMode", async () => {
+    const push = vi.spyOn(window.history, "pushState");
+    const back = vi.spyOn(window.history, "back").mockImplementation(() => {});
+    render(
+      <StrictMode>
+        <div data-testid="shell">
+          <GridMobileGame onExit={vi.fn()}>
+            <canvas />
+          </GridMobileGame>
+        </div>
+      </StrictMode>,
+    );
+    const game = screen.getByRole("region", { name: "Full-screen office game" });
+    expect(game.parentElement).toBe(document.body);
+    expect(screen.getByTestId("shell")).not.toContainElement(game);
+    expect(push).toHaveBeenCalledTimes(1);
+    await userEvent.click(screen.getByRole("button", { name: "Return to command" }));
+    expect(back).toHaveBeenCalledTimes(1);
+  });
+  it("returns to command when the browser goes back", () => {
+    const exit = vi.fn();
+    render(
+      <GridMobileGame onExit={exit}>
+        <canvas />
+      </GridMobileGame>,
+    );
+    fireEvent(window, new PopStateEvent("popstate"));
+    expect(exit).toHaveBeenCalledOnce();
+  });
+  it("lets a program dialog own Escape before the game", () => {
+    const back = vi.spyOn(window.history, "back").mockImplementation(() => {});
+    const view = render(
+      <>
+        <GridMobileGame onExit={vi.fn()}>
+          <canvas />
+        </GridMobileGame>
+        <div role="dialog">Program</div>
+      </>,
+    );
+    fireEvent.keyDown(window, { key: "Escape" });
+    expect(back).not.toHaveBeenCalled();
+    view.rerender(
+      <GridMobileGame onExit={vi.fn()}>
+        <canvas />
+      </GridMobileGame>,
+    );
+    fireEvent.keyDown(window, { key: "Escape" });
+    expect(back).toHaveBeenCalledOnce();
+  });
+  it("removes only its own marker when the game unmounts", async () => {
+    window.history.replaceState({ page: "grid" }, "");
+    const { unmount } = render(
+      <GridMobileGame onExit={vi.fn()}>
+        <canvas />
+      </GridMobileGame>,
+    );
+    expect(window.history.state.clawOfficeGame).toBeTruthy();
+    unmount();
+    await Promise.resolve();
+    expect(window.history.state).toEqual({ page: "grid" });
+  });
+});
diff --git a/src/components/GridMobileGame.tsx b/src/components/GridMobileGame.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..f86a511fcfc2f9b81c814a00d73fb6633fa4291a
--- /dev/null
+++ b/src/components/GridMobileGame.tsx
@@ -0,0 +1,67 @@
+import { useCallback, useEffect, useRef, type ReactNode } from "react";
+import { createPortal } from "react-dom";
+import GridIcon from "./GridIcon";
+
+/** A body-level game surface avoids the dashboard's scroll/transform clipping. */
+export default function GridMobileGame({ children, onExit }: { children: ReactNode; onExit: () => void }) {
+  const surface = useRef<HTMLDivElement>(null);
+  const entry = useRef<string | null>(null);
+  const previousState = useRef<unknown>(null);
+  const lifecycle = useRef(0);
+  const exitRef = useRef(onExit);
+  exitRef.current = onExit;
+  const leave = useCallback(() => {
+    if (entry.current && window.history.state?.clawOfficeGame === entry.current) window.history.back();
+    else exitRef.current();
+  }, []);
+  const disposeHistory = useCallback((generation: number) => {
+    if (lifecycle.current === generation && window.history.state?.clawOfficeGame === entry.current) {
+      window.history.replaceState(previousState.current, "");
+    }
+  }, []);
+  useEffect(() => {
+    const generation = ++lifecycle.current;
+    const previousFocus = document.activeElement as HTMLElement | null;
+    if (!entry.current) {
+      entry.current = `claw-office-${Date.now()}`;
+      previousState.current = window.history.state;
+      window.history.pushState({ ...window.history.state, clawOfficeGame: entry.current }, "");
+    }
+    surface.current?.focus({ preventScroll: true });
+    const onPop = () => exitRef.current();
+    const onKey = (event: KeyboardEvent) => {
+      // Existing agent/department sheets own Escape while they are above the game.
+      if (
+        event.key !== "Escape" ||
+        event.defaultPrevented ||
+        document.querySelector('[role="dialog"], [aria-modal="true"], .grid-chat-panel, .fixed.inset-0.z-50')
+      )
+        return;
+      event.preventDefault();
+      leave();
+    };
+    window.addEventListener("popstate", onPop);
+    window.addEventListener("keydown", onKey);
+    return () => {
+      window.removeEventListener("popstate", onPop);
+      window.removeEventListener("keydown", onKey);
+      previousFocus?.focus({ preventScroll: true });
+      // Delay disposal past StrictMode's immediate effect replay.
+      queueMicrotask(() => disposeHistory(generation));
+    };
+  }, [disposeHistory, leave]);
+  return createPortal(
+    <div ref={surface} className="grid-mobile-game" role="region" aria-label="Full-screen office game" tabIndex={-1}>
+      <div className="grid-mobile-game-hud">
+        <button type="button" onClick={leave} aria-label="Return to command">
+          <span aria-hidden="true">←</span> Command
+        </button>
+        <span>
+          <GridIcon name="disc" size={15} /> CLAW EMPIRE <small>LIVE OFFICE</small>
+        </span>
+      </div>
+      {children}
+    </div>,
+    document.body,
+  );
+}

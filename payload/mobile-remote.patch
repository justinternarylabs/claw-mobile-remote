+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { render, screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import BrowserNotificationsPanel from "./BrowserNotificationsPanel";
+import { request } from "../../api/core";
+vi.mock("../../api/core", () => ({ request: vi.fn() }));
+
+const originalAgent = navigator.userAgent;
+const originalMatch = window.matchMedia;
+beforeEach(() => {
+  vi.mocked(request).mockReset();
+  localStorage.clear();
+  Object.defineProperty(window, "isSecureContext", { configurable: true, value: true });
+  Object.defineProperty(window, "PushManager", { configurable: true, value: class {} });
+  Object.defineProperty(window, "Notification", {
+    configurable: true,
+    value: { requestPermission: vi.fn().mockResolvedValue("denied") },
+  });
+  Object.defineProperty(navigator, "userAgent", { configurable: true, value: "Desktop test" });
+  Object.defineProperty(navigator, "serviceWorker", {
+    configurable: true,
+    value: { getRegistration: vi.fn().mockResolvedValue(undefined), register: vi.fn() },
+  });
+  window.matchMedia = vi.fn().mockReturnValue({ matches: false });
+});
+afterEach(() => {
+  Object.defineProperty(navigator, "userAgent", { configurable: true, value: originalAgent });
+  window.matchMedia = originalMatch;
+  vi.restoreAllMocks();
+});
+
+describe("browser notification consent", () => {
+  it("never requests permission until tapped, and does not register a denied device", async () => {
+    render(<BrowserNotificationsPanel />);
+    expect(Notification.requestPermission).not.toHaveBeenCalled();
+    await userEvent.click(screen.getByRole("button", { name: "Enable notifications" }));
+    expect(await screen.findByRole("alert")).toHaveTextContent("Notifications are blocked");
+    expect(request).not.toHaveBeenCalled();
+    expect(navigator.serviceWorker.register).not.toHaveBeenCalled();
+  });
+
+  it("explains the iPhone Home Screen step and prevents an unsupported tab prompt", () => {
+    Object.defineProperty(navigator, "userAgent", { configurable: true, value: "iPhone Safari" });
+    render(<BrowserNotificationsPanel />);
+    expect(screen.getByText(/open this HTTPS page in Safari/)).toBeVisible();
+    expect(screen.getByRole("button", { name: "Enable notifications" })).toBeDisabled();
+  });
+
+  it("rolls back a new browser subscription if server registration fails", async () => {
+    const unsubscribe = vi.fn().mockResolvedValue(true);
+    const subscription = { endpoint: "https://web.push.apple.com/device", toJSON: () => ({}), unsubscribe };
+    const registration = {
+      pushManager: {
+        getSubscription: vi.fn().mockResolvedValue(null),
+        subscribe: vi.fn().mockResolvedValue(subscription),
+      },
+    };
+    Object.defineProperty(navigator, "serviceWorker", {
+      configurable: true,
+      value: {
+        getRegistration: vi.fn().mockResolvedValue(undefined),
+        register: vi.fn().mockResolvedValue(registration),
+        ready: Promise.resolve(registration),
+      },
+    });
+    vi.mocked(Notification.requestPermission).mockResolvedValue("granted");
+    vi.mocked(request)
+      .mockResolvedValueOnce({ enabled: true, publicKey: "AQIDBA" })
+      .mockRejectedValueOnce(new Error("Network unavailable"));
+    render(<BrowserNotificationsPanel />);
+    await userEvent.click(screen.getByRole("button", { name: "Enable notifications" }));
+    await waitFor(() => expect(unsubscribe).toHaveBeenCalledOnce());
+    expect(screen.getByRole("alert")).toHaveTextContent("Network unavailable");
+    expect(screen.getByRole("button", { name: "Enable notifications" })).toBeEnabled();
+  });
+});
diff --git a/src/components/settings/BrowserNotificationsPanel.tsx b/src/components/settings/BrowserNotificationsPanel.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..82f24b36d3a71726bc0250e4967386620a79e358
--- /dev/null
+++ b/src/components/settings/BrowserNotificationsPanel.tsx
@@ -0,0 +1,205 @@
+import { useCallback, useEffect, useState } from "react";
+import { request } from "../../api/core";
+import GridIcon from "../GridIcon";
+
+const DEVICE_KEY = "claw_push_device";
+
+function notificationError(cause: unknown, fallback: string): string {
+  if (!(cause instanceof Error)) return fallback;
+  const details = "details" in cause ? cause.details : null;
+  if (details && typeof details === "object" && "message" in details && typeof details.message === "string")
+    return details.message;
+  return cause.message;
+}
+
+function pushDeviceToken(): string {
+  const stored = localStorage.getItem(DEVICE_KEY);
+  if (stored && /^[A-Za-z0-9_-]{43}$/.test(stored)) return stored;
+  const bytes = crypto.getRandomValues(new Uint8Array(32));
+  const token = btoa(String.fromCharCode(...bytes))
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+  localStorage.setItem(DEVICE_KEY, token);
+  return token;
+}
+
+export function decodePushKey(value: string): ArrayBuffer {
+  const normalized = value.replace(/-/g, "+").replace(/_/g, "/");
+  const raw = atob(normalized.padEnd(Math.ceil(normalized.length / 4) * 4, "="));
+  return Uint8Array.from(raw, (character) => character.charCodeAt(0)).buffer;
+}
+
+export default function BrowserNotificationsPanel() {
+  const [enabled, setEnabled] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState("");
+  const [error, setError] = useState("");
+  const supported =
+    window.isSecureContext && "serviceWorker" in navigator && "PushManager" in window && "Notification" in window;
+  const isIPhone = /iPhone|iPad|iPod/i.test(navigator.userAgent);
+  const standalone =
+    window.matchMedia?.("(display-mode: standalone)").matches ||
+    (navigator as Navigator & { standalone?: boolean }).standalone;
+  const needsHomeScreen = isIPhone && !standalone;
+
+  const refresh = useCallback(async () => {
+    if (!supported) return;
+    const registration = await navigator.serviceWorker.getRegistration("/");
+    setEnabled(Boolean(await registration?.pushManager.getSubscription()));
+  }, [supported]);
+
+  useEffect(() => {
+    void refresh().catch(() => {});
+    const onVisible = () => {
+      if (document.visibilityState === "visible") void refresh().catch(() => {});
+    };
+    document.addEventListener("visibilitychange", onVisible);
+    return () => document.removeEventListener("visibilitychange", onVisible);
+  }, [refresh]);
+
+  async function enable() {
+    setBusy(true);
+    setError("");
+    setMessage("");
+    let created: PushSubscription | null = null;
+    try {
+      // Permission is requested only from this explicit button gesture.
+      const permission = await Notification.requestPermission();
+      if (permission !== "granted")
+        throw new Error(
+          "Notifications are blocked. Allow notifications for Claw-Empire in your browser or iPhone settings, then try again.",
+        );
+      const config = await request<{ enabled: boolean; publicKey: string }>("/api/push/config");
+      if (!config.enabled || !config.publicKey) throw new Error("Push notifications are unavailable on this server.");
+      await navigator.serviceWorker.register("/claw-sw.js", { scope: "/" });
+      const registration = await navigator.serviceWorker.ready;
+      let subscription = await registration.pushManager.getSubscription();
+      if (!subscription) {
+        subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: decodePushKey(config.publicKey),
+        });
+        created = subscription;
+      }
+      await request("/api/push/subscribe", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ subscription: subscription.toJSON(), deviceToken: pushDeviceToken() }),
+      });
+      setEnabled(true);
+      setMessage(
+        "Enabled for this device. You will receive private alerts for completed work, failures, and decisions that need you.",
+      );
+    } catch (cause) {
+      if (created) await created.unsubscribe().catch(() => {});
+      setError(notificationError(cause, "Could not enable notifications."));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function disable() {
+    setBusy(true);
+    setError("");
+    setMessage("");
+    try {
+      const registration = await navigator.serviceWorker.getRegistration("/");
+      const subscription = await registration?.pushManager.getSubscription();
+      const token = localStorage.getItem(DEVICE_KEY);
+      if (subscription && token)
+        await request("/api/push/unsubscribe", {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify({ endpoint: subscription.endpoint, deviceToken: token }),
+        });
+      await subscription?.unsubscribe();
+      setEnabled(false);
+      setMessage("Notifications disabled for this device.");
+    } catch {
+      setError("Could not disable notifications. Check your connection and try again.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function test() {
+    setBusy(true);
+    setError("");
+    setMessage("");
+    try {
+      const deviceToken = localStorage.getItem(DEVICE_KEY);
+      if (!deviceToken) throw new Error("Re-enable notifications to register this device.");
+      await request("/api/push/test", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ deviceToken }),
+      });
+      setMessage("Test notification sent to this device. Delivery can take a moment.");
+    } catch (cause) {
+      setError(notificationError(cause, "Could not send a test notification."));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <section className="grid-access-panel space-y-4" aria-label="Browser notifications">
+      <div className="flex items-center gap-3">
+        <span className="grid-cyan">
+          <GridIcon name="broadcast" />
+        </span>
+        <div>
+          <h3 className="text-sm font-semibold">Notifications</h3>
+          <p className="text-xs mt-1" style={{ color: "var(--th-text-muted)" }}>
+            Private alerts, even when this page is closed.
+          </p>
+        </div>
+      </div>
+      {needsHomeScreen && (
+        <div className="grid-access-hint text-xs leading-relaxed">
+          <strong>On iPhone:</strong> open this HTTPS page in Safari, tap Share, then Add to Home Screen. Open
+          Claw-Empire from that icon and enable notifications here. No App Store download is needed.
+        </div>
+      )}
+      {!window.isSecureContext ? (
+        <p className="text-xs leading-relaxed">
+          Open your secure HTTPS remote address to enable notifications. Plain HTTP on a phone cannot receive Web Push.
+        </p>
+      ) : !supported ? (
+        <p className="text-xs leading-relaxed">
+          This browser does not currently support Web Push. On iPhone, use the Home Screen version on iOS 16.4 or later.
+        </p>
+      ) : (
+        <div className="flex flex-wrap gap-2">
+          <button
+            className="grid-access-primary"
+            disabled={busy || Boolean(needsHomeScreen)}
+            onClick={() => void (enabled ? disable() : enable())}
+          >
+            {busy ? "Working…" : enabled ? "Disable on this device" : "Enable notifications"}
+          </button>
+          {enabled && (
+            <button className="grid-access-secondary" disabled={busy} onClick={() => void test()}>
+              Send test
+            </button>
+          )}
+        </div>
+      )}
+      <p className="text-[11px] leading-relaxed" style={{ color: "var(--th-text-muted)" }}>
+        Alerts contain no task details, messages, or project paths. Your PC and Claw-Empire server must stay running to
+        send them. Open alerts through your private connection to act.
+      </p>
+      {message && (
+        <p role="status" className="text-xs grid-cyan">
+          {message}
+        </p>
+      )}
+      {error && (
+        <p role="alert" className="text-xs text-red-400">
+          {error}
+        </p>
+      )}
+    </section>
+  );
+}

new file mode 100644
index 0000000000000000000000000000000000000000..cdb6720db6511719922ca5295d7486e54da6725e
--- /dev/null
+++ b/src/components/GridMobileNav.tsx
@@ -0,0 +1,140 @@
+import { useEffect, useRef, useState } from "react";
+import type { View } from "../app/types";
+import GridIcon from "./GridIcon";
+
+type Props = {
+  view: View;
+  onNavigate: (view: View) => void;
+  onReports: () => void;
+  onDecisions: () => void;
+  onBroadcast: () => void;
+  onStatus: () => void;
+  onRooms: () => void;
+  decisionCount: number;
+};
+const ITEMS = [
+  { view: "office", label: "Office" },
+  { view: "agents", label: "Agents" },
+  { view: "tasks", label: "Tasks" },
+  { view: "skills", label: "Skills" },
+] as const;
+
+export default function GridMobileNav(props: Props) {
+  const [open, setOpen] = useState(false);
+  const trigger = useRef<HTMLButtonElement>(null);
+  const sheet = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    if (!open) return;
+    const previous = document.activeElement as HTMLElement | null;
+    sheet.current?.querySelector<HTMLButtonElement>("button")?.focus();
+    const keydown = (event: KeyboardEvent) => {
+      if (event.key === "Escape") setOpen(false);
+      if (event.key !== "Tab") return;
+      const buttons = sheet.current?.querySelectorAll<HTMLButtonElement>("button");
+      if (!buttons?.length) return;
+      const first = buttons[0],
+        last = buttons[buttons.length - 1];
+      if (event.shiftKey && document.activeElement === first) {
+        event.preventDefault();
+        last.focus();
+      } else if (!event.shiftKey && document.activeElement === last) {
+        event.preventDefault();
+        first.focus();
+      }
+    };
+    window.addEventListener("keydown", keydown);
+    return () => {
+      window.removeEventListener("keydown", keydown);
+      previous?.focus();
+    };

+    keys = deps.vapidKeys
+      ? validateVapidKeys(deps.vapidKeys)
+      : loadVapidKeys(deps.keysPath ?? path.resolve(".climpire", "web-push-vapid.json"));
+  } catch {
+    console.warn("[Claw Push] Notifications unavailable: local signing key could not be loaded.");
+  }
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS claw_push_subscriptions (
+      device_hash TEXT PRIMARY KEY,
+      owner_session_id TEXT,
+      endpoint TEXT NOT NULL UNIQUE,
+      subscription_json TEXT NOT NULL,
+      created_at INTEGER NOT NULL,
